new file mode 100644
index 0000000000000000000000000000000000000000..3041a952f9f866fbe8276b687e4f03a1a1165792
--- /dev/null
+++ b/DirectRenderingCluster/src/android/car/cluster/ArdaProjectionRoutingPolicy.java
@@ -0,0 +1,65 @@
+package android.car.cluster;
+
+import java.util.Collections;
+import java.util.HashMap;
+import java.util.Map;
+
+/** Pure protocol-state policy; display ids here are AAP service-discovery ids, NOT Android ids. */
+public final class ArdaProjectionRoutingPolicy {
+    public enum Type { MAIN, CLUSTER, AUXILIARY }
+    public enum Target { AAOS_MAIN, CLUSTER_MAP_VIEWPORT, AUX_MAP_VIEWPORT, UNMAPPED }
+
+    public static final class Route {
+        public final int serviceDisplayId;
+        public final Type type;
+        public final Target target;
+        private Route(int id, Type type, Target target) {
+            this.serviceDisplayId = id;
+            this.type = type;
+            this.target = target;
+        }
+    }
+
+    private final Map<Integer, Route> mRoutes = new HashMap<>();
+    private boolean mAuxMapAllowed;
+
+    /** AUX never hijacks the cluster by default; Platform must explicitly configure a map target. */
+    public void allowAuxMap(boolean enabled) {
+        mAuxMapAllowed = enabled;
+        for (Map.Entry<Integer, Route> e : mRoutes.entrySet()) {
+            if (e.getValue().type == Type.AUXILIARY) {
+                e.setValue(new Route(e.getKey(), Type.AUXILIARY,
+                        enabled ? Target.AUX_MAP_VIEWPORT : Target.UNMAPPED));
+            }
+        }
+    }
+
+    public Route advertise(int aapDisplayId, Type type) {
+        if (type == null || aapDisplayId < 0) throw new IllegalArgumentException("Invalid stream");
+        Route existing = mRoutes.get(aapDisplayId);
+        if (existing != null && existing.type != type) {
+            throw new IllegalStateException("AAP display id reused with different type");
+        }
+        if (existing != null) return existing;
+        if (type == Type.MAIN || type == Type.CLUSTER) {
+            for (Route route : mRoutes.values()) {
+                if (route.type == type) throw new IllegalStateException("Duplicate " + type);
+            }
+        }
+        Target target;
+        switch (type) {
+            case MAIN: target = Target.AAOS_MAIN; break;
+            case CLUSTER: target = Target.CLUSTER_MAP_VIEWPORT; break;
+            default: target = mAuxMapAllowed ? Target.AUX_MAP_VIEWPORT : Target.UNMAPPED;
+        }
+        Route result = new Route(aapDisplayId, type, target);
+        mRoutes.put(aapDisplayId, result);
+        return result;
+    }
+
+    public void remove(int aapDisplayId) { mRoutes.remove(aapDisplayId); }
+    public void disconnect() { mRoutes.clear(); }
+    public Map<Integer, Route> snapshot() {
+        return Collections.unmodifiableMap(new HashMap<>(mRoutes));
+    }
+}
diff --git a/DirectRenderingCluster/src/android/car/cluster/ArdaProjectionSurface.java b/DirectRenderingCluster/src/android/car/cluster/ArdaProjectionSurface.java
new file mode 100644
index 0000000000000000000000000000000000000000..481400a237e1f1e22820681e915edc392ef278cf
--- /dev/null
+++ b/DirectRenderingCluster/src/android/car/cluster/ArdaProjectionSurface.java
@@ -0,0 +1,138 @@
+package android.car.cluster;
+
+import android.app.Activity;
+import android.graphics.Rect;
+import android.os.Looper;
+import android.view.Gravity;
+import android.view.Surface;
+import android.view.SurfaceHolder;
+import android.view.SurfaceView;
+import android.view.View;
+import android.view.ViewGroup;
+import android.widget.FrameLayout;
+
+/**
+ * Activity-owned video viewport for a negotiated projection CLUSTER stream.
+ * Not tied to NavigationFragment, a virtual display, or a SurfaceFlinger display id.
+ * This version is deliberately dormant; no video is shown until a trusted in-process
+ * controller explicitly calls showInViewport(). It does NOT expose an IPC endpoint.
+ */
+public final class ArdaProjectionSurface implements SurfaceHolder.Callback {
+    public interface Listener {
+        void onSurfaceReady(Surface surface, int width, int height, long generation);
+        void onSurfaceGone(long generation);
+    }
+
+    private final FrameLayout mRoot;
+    private final FrameLayout mContainer;
+    private final SurfaceView mVideoView;
+    private Listener mListener;
+    private long mGeneration;
+    private boolean mReady;
+    private boolean mReleased;
+
+    public ArdaProjectionSurface(Activity activity) {
+        requireMainThread();
+        mRoot = activity.findViewById(android.R.id.content);
+        if (mRoot == null) {
+            throw new IllegalStateException("No Android activity content root");
+        }
+        mContainer = new FrameLayout(activity);
+        mContainer.setVisibility(View.GONE);
+        mContainer.setFocusable(false);
+        mContainer.setClickable(false);
+        mContainer.setContentDescription("ARDA projection viewport (inactive)");
+        FrameLayout.LayoutParams full = new FrameLayout.LayoutParams(
+                ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.MATCH_PARENT);
+        mRoot.addView(mContainer, full);
+
+        mVideoView = new SurfaceView(activity);
+        mVideoView.setZOrderMediaOverlay(true);
+        mVideoView.setClickable(false);
+        mVideoView.setFocusable(false);
+        mVideoView.getHolder().addCallback(this);
+        mContainer.addView(mVideoView, new FrameLayout.LayoutParams(
+                ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.MATCH_PARENT));
+    }
+
+    private static void requireMainThread() {
+        if (Looper.myLooper() != Looper.getMainLooper()) {
+            throw new IllegalStateException("Projection viewport must be managed on main thread");
+        }
+    }
+
+    public void setListener(Listener listener) {
+        requireMainThread();
+        checkActive();
+        mListener = listener;
+        SurfaceHolder holder = mVideoView.getHolder();
+        if (listener != null && mReady && holder.getSurface().isValid()) {
+            listener.onSurfaceReady(holder.getSurface(), mVideoView.getWidth(),
+                    mVideoView.getHeight(), mGeneration);
+        }
+    }
+
+    /** Rect coordinates are relative to the cluster Activity content root. */
+    public void showInViewport(Rect viewport) {
+        requireMainThread();
+        checkActive();
+        if (viewport == null || viewport.isEmpty()
+                || viewport.left < 0 || viewport.top < 0
+                || viewport.right > mRoot.getWidth()
+                || viewport.bottom > mRoot.getHeight()) {
+            throw new IllegalArgumentException("Invalid or not-yet-laid-out viewport");
+        }
+        FrameLayout.LayoutParams params = new FrameLayout.LayoutParams(
+                viewport.width(), viewport.height(), Gravity.TOP | Gravity.LEFT);
+        params.leftMargin = viewport.left;
+        params.topMargin = viewport.top;
+        mContainer.setLayoutParams(params);
+        mContainer.setVisibility(View.VISIBLE);
+    }
+
+    /** Hides the video safely without modifying the local cluster or the map virtual display. */
+    public void hide() {
+        requireMainThread();
+        if (!mReleased) mContainer.setVisibility(View.GONE);
+    }
+
+    @Override
+    public void surfaceCreated(SurfaceHolder holder) {
+        // Width/height are reported only after surfaceChanged().
+    }
+
+    @Override
+    public void surfaceChanged(SurfaceHolder holder, int format, int width, int height) {
+        if (mReleased) return;
+        mReady = true;
+        mGeneration++;
+        if (mListener != null && holder.getSurface().isValid()) {
+            mListener.onSurfaceReady(holder.getSurface(), width, height, mGeneration);
+        }
+    }
+
+    @Override
+    public void surfaceDestroyed(SurfaceHolder holder) {
+        if (!mReady) return;
+        mReady = false;
+        mGeneration++;
+        if (mListener != null) mListener.onSurfaceGone(mGeneration);
+    }
+
+    public void release() {
+        requireMainThread();
+        if (mReleased) return;
+        hide();
+        mReleased = true;
+        mReady = false;
+        mGeneration++;
+        if (mListener != null) mListener.onSurfaceGone(mGeneration);
+        mListener = null;
+        mVideoView.getHolder().removeCallback(this);
+        mRoot.removeView(mContainer);
+    }
+
+    private void checkActive() {
+        if (mReleased) throw new IllegalStateException("Projection viewport released");
+    }
+}
